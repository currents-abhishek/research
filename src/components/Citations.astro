---
// Rendered from structured frontmatter (§6). In prose, reference one with
// <Cite id="..." /> or a plain link to #cite-{id}.
import { fmtDate } from "../lib/site"
interface Citation { id: string; title: string; url: string; publisher?: string; accessed?: Date }
interface Props { citations: Citation[] }
const { citations } = Astro.props
---
{citations.length > 0 && (
  <section class="citations" aria-labelledby="citations-heading">
    <h2 id="citations-heading">Sources</h2>
    <ol>
      {citations.map((c) => (
        <li id={`cite-${c.id}`}>
          <a class="cite-title" href={c.url} rel="noopener">{c.title}</a>
          {c.publisher && <span class="cite-pub">{c.publisher}</span>}
          {c.accessed && <span class="cite-acc">accessed {fmtDate(c.accessed)}</span>}
        </li>
      ))}
    </ol>
  </section>
)}
