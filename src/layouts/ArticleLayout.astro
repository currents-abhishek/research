---
import BaseLayout from "./BaseLayout.astro"
import ArticleMeta from "../components/ArticleMeta.astro"
import Citations from "../components/Citations.astro"
import { absolute, path, readingTime, type Research } from "../lib/site"
import { topic } from "../lib/topics"
import { graph, organization, person, ORGANIZATION_ID, PERSON_ID } from "../lib/entity"

interface Props { entry: Research }
const { entry } = Astro.props
const { title, description, publishDate, updatedDate, topics, heroImage, citations, canonicalUrl } = entry.data
const url = absolute(entry.id)
const canonical = canonicalUrl ?? url
const minutes = readingTime(entry)
const image = heroImage ? (/^https?:/.test(heroImage) ? heroImage : `https://acme.bot${path(heroImage)}`) : undefined

// Research is bylined: these are original studies with a named researcher
// behind them, so author is the Person and publisher is the Organization.
// (/blog is the other way round — the agent drafts and Abhishek edits — which
// is why that graph sets author=Organization, editor=Person. Each mirrors its
// own visible byline; a graph that contradicts the page it sits on is the one
// thing that gets the whole block discounted.)
//
// One @graph rather than separate top-level objects so the @id references
// below resolve within the page.
const jsonLd = [
  graph(
    person,
    organization,
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      headline: title,
      description,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate ?? publishDate).toISOString(),
      ...(image ? { image: [image] } : {}),
      ...(topics.length ? { keywords: topics.map((t) => topic(t).name).join(", ") } : {}),
      author: { "@id": PERSON_ID },
      publisher: { "@id": ORGANIZATION_ID },
    },
    {
      // Mirrors the plugin's B7 shape: ACME.BOT › Research › article (last crumb has no URL).
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ACME.BOT", item: "https://acme.bot/" },
        { "@type": "ListItem", position: 2, name: "Research", item: absolute() },
        { "@type": "ListItem", position: 3, name: title },
      ],
    }
  ),
]
---
<BaseLayout title={`${title} — ACME.BOT Research`} {description} {canonical} ogType="article" ogImage={image} {jsonLd}>
  <article class="column">
    <header class="article-head">
      <p class="eyebrow"><a href={path()}>← Research</a></p>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      <ArticleMeta {publishDate} {updatedDate} readingTime={minutes} {topics} byline />
    </header>
    {heroImage && (
      <div class="article-hero">
        <img src={path(heroImage)} alt="" width="1200" height="630" decoding="async" fetchpriority="high" />
      </div>
    )}
    <div class="prose">
      <slot />
    </div>
    <Citations {citations} />
    <footer class="article-foot">
      <p class="meta"><a href={path()}>← All research</a><a href="/blog/">The AI SEO Blog</a></p>
    </footer>
  </article>
</BaseLayout>

<script>
  // Clicking the # / ## marker copies that section's absolute URL. Falls back to
  // normal anchor navigation if the clipboard is unavailable (http, denied, old
  // browser), so the link is never a dead end.
  document.querySelectorAll<HTMLAnchorElement>(".prose .hanchor").forEach((a) => {
    a.addEventListener("click", async (ev) => {
      const url = new URL(a.getAttribute("href")!, location.href).href
      try {
        await navigator.clipboard.writeText(url)
      } catch {
        return // let the browser follow the anchor
      }
      ev.preventDefault()
      history.replaceState(null, "", a.getAttribute("href")!)
      a.classList.add("copied")
      setTimeout(() => a.classList.remove("copied"), 1200)
    })
  })
</script>

